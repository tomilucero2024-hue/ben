# Bytecode de Python: se regenera solo en cada corrida de los scrapers.
__pycache__/
*.py[cod]

# Entornos virtuales
.venv/
venv/
env/

# Basura del sistema y de los editores
Thumbs.db
desktop.ini
.DS_Store

# Dependencias JS para los tests (jsdom) y scripts descartables de una corrida
node_modules/
patch_*.js
check_braces.js
update_settings.js

# Credenciales de servicio de Google (Google Analytics, Search Console). Nunca
# se versionan: son una llave privada. El script que las usa explica cómo
# generarlas (registrar-dimensiones-ga4.js).
*-service-account*.json
ga4-*.json
.clave-ga4.json
