/* ================================================================
   1. COLORES, MEDIDAS Y AJUSTES GENERALES
   Cambiá estos valores para modificar el fondo, los colores globales,
   los bordes redondeados y el ancho máximo del contenido.
   ================================================================ */
:root {
    --radius: 14px;
    --container: 1280px;
    --font-title: "Sifonn Pro", Sifonn, Montserrat, sans-serif;
    --font-detail: "Bebas Neue", sans-serif;
    --font-text: Montserrat, sans-serif;
    /* Progreso de scroll del header (0 = arriba del todo, 1 = header ya achicado).
       Lo actualiza app.js en cada cuadro mientras se hace scroll. */
    --scroll-progress: 0;
    /* Versión escalonada del progreso, solo para el desenfoque (ver app.js). */
    --blur-progress: 0;
    --blur-max: 34px;

    /* ---- Escalas ----------------------------------------------------------
       Todo el CSS sale de acá. Antes había 27 tamaños de fuente, 46 paddings y
       11 radios distintos: valores que no eran decisiones sino acumulación.
       Si algo necesita un valor intermedio, casi siempre conviene elegir el
       paso de al lado antes que inventar uno nuevo. */
    --space-1: .25rem;  --space-2: .375rem; --space-3: .5rem;
    --space-4: .75rem;  --space-5: 1rem;    --space-6: 1.25rem;
    --space-7: 1.5rem;  --space-8: 2rem;    --space-9: 2.5rem;

    --radius-xs: 6px;   --radius-sm: 8px;   --radius-md: 12px;
    --radius-lg: 16px;  --radius-pill: 999px; --radius-round: 50%;

    /* Escalera de elevación. Referencian var(--shadow), que cambia por tema:
       las custom properties se resuelven al usarse, así que siguen al tema. */
    --elev-1: 0 1px 2px var(--shadow);
    --elev-2: 0 6px 18px var(--shadow);
    --elev-3: 0 12px 30px var(--shadow);
    --elev-4: 0 22px 60px var(--shadow);

    --dur-fast: 120ms;  --dur-base: 180ms;  --dur-slow: 260ms;

    --fs-2xs: .75rem;   --fs-xs: .8125rem;  --fs-sm: .875rem;
    --fs-base: .9375rem; --fs-md: 1rem;     --fs-lg: 1.125rem;
    --fs-xl: 1.375rem;  --fs-2xl: 1.75rem;
    --fs-hero: clamp(1.75rem, 5vw, 2.75rem);

    /* ---- Paleta ------------------------------------------------------------
       El tema lo fija un script inline en el <head>. Si ese script no llega a
       correr (JS desactivado, error, CSP), sin estos valores acá var(--bg) y
       var(--text) quedaban inválidos y la página entera perdía color. Esta es
       la paleta clara, que oficia de red de contención. */
    --bg: #DDE1DE;
    --surface: #F2F4F2;
    --surface-soft: #E8ECE9;
    --line: rgba(21, 17, 29, .15);
    --text: #15111D;
    --muted: #57515F;
    --orange: #FF5400;
    --green: #02A549;
    --blue: #337CFF;
    --purple: #7C1897;
    --accent: #337CFF;
    --shadow: rgba(21, 17, 29, .15);

    /* Tinta de los badges. El color puro sobre su propio tinte al 16% daba ~2.5:1
       (ilegible al sol); estos son el mismo matiz con la luminancia corregida
       para pasar 4.5:1. El fondo sigue siendo el color puro tinteado. */
    --orange-ink: #9C3300;
    --green-ink: #015B27;
    --blue-ink: #2253AB;
    --purple-ink: #7C1897;
    --accent-ink: var(--blue-ink);
    /* Texto sobre relleno saturado claro (azul, naranja, verde). */
    --on-accent: #15111D;
    /* El violeta es el único relleno oscuro: lleva texto blanco. */
    --purple-fill: #7C1897;
    --on-purple: #FFFFFF;
    /* Borde de controles de formulario: --line queda en ~1.3:1 y la norma pide 3:1. */
    --line-strong: rgba(21, 17, 29, .5);
}

html[data-theme="dark"] {
    --bg: #15111D;
    --surface: #211B2C;
    --surface-soft: #2A2335;
    --line: rgba(221, 225, 222, .16);
    --text: #DDE1DE;
    --muted: #B7B8BC;
    --orange: #FF7633;
    --green: #35B76D;
    --blue: #669DFF;
    --purple: #8866C2;
    --accent: #669DFF;
    --shadow: rgba(0, 0, 0, .34);

    --orange-ink: #FF7D3D;
    --green-ink: #39B870;
    --blue-ink: #6FA3FF;
    --purple-ink: #A991D3;
    --accent-ink: var(--blue-ink);
    --on-accent: #15111D;
    /* Más oscuro que --purple: con el violeta del tema oscuro, el blanco encima
       se quedaba en 4.4:1, apenas por debajo del mínimo. */
    --purple-fill: #6B4EA8;
    --on-purple: #FFFFFF;
    --line-strong: rgba(221, 225, 222, .42);
}

html[data-theme="light"] {
    --bg: #DDE1DE;
    --surface: #F2F4F2;
    --surface-soft: #E8ECE9;
    --line: rgba(21, 17, 29, .15);
    --text: #15111D;
    --muted: #57515F;
    --orange: #FF5400;
    --green: #02A549;
    --blue: #337CFF;
    --purple: #7C1897;
    --accent: #337CFF;
    --shadow: rgba(21, 17, 29, .15);

    --orange-ink: #9C3300;
    --green-ink: #015B27;
    --blue-ink: #2253AB;
    --purple-ink: #7C1897;
    --accent-ink: var(--blue-ink);
    --on-accent: #15111D;
    --purple-fill: #7C1897;
    --on-purple: #FFFFFF;
    --line-strong: rgba(21, 17, 29, .5);
}

/* 2. BASE DE LA PÁGINA: tipografía, fondo y comportamiento global. */
* { box-sizing: border-box; }
body {
    margin: 0;
    min-width: 320px;
    /* Reserva el alto del header expandido (lo mide app.js). El valor de reserva
       es solo por si el JS no llega a correr. */
    padding-top: var(--hero-alto, 440px);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-text);
    line-height: 1.5;
    transition: background-color .25s ease, color .25s ease;
}
button, input, select { font: inherit; }
button { cursor: pointer; }
[hidden] { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

/* Con el header fijo y 35 filtros antes de los resultados en el orden del DOM,
   sin esto no había forma de saltearlos con el teclado. Solo se ve al enfocarlo. */
.skip-link {
    position: absolute; left: .5rem; top: -100px; z-index: 100;
    padding: .7rem 1rem; border-radius: var(--radius-sm);
    color: var(--on-accent); background: var(--accent);
    font-weight: 700; text-decoration: none;
}
.skip-link:focus { top: .5rem; }

/* #7 Accesibilidad de foco: anillo visible y de alto contraste para todo elemento
   navegable por teclado. Usa la variable de acento del tema, así respeta claro/oscuro. */
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ================================================================
   3. ENCABEZADO / PORTADA
   Incluye el degradado superior, el título principal y el texto.
   ================================================================ */
.hero {
    /* Fijo arriba siempre: a medida que --scroll-progress avanza (lo actualiza app.js
       mientras se hace scroll), el logo y el buscador se convierten en dos "píldoras"
       (una gris con el logo a la izquierda, una clara con el buscador a la derecha)
       flotando sobre un fondo con blur estilo vidrio esmerilado (iOS). */
    /* Fijo (no sticky): al achicarse, su alto ya no empuja al contenido, así que
       no se reflota la página entera en cada cuadro. El espacio que ocuparía
       expandido lo reserva el padding-top del body (--hero-alto, lo mide app.js). */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    contain: layout;
    --hero-pad-top: 4.5rem;
    --hero-pad-bottom: 3rem;
    --hero-pad-compacto: .6rem;
    /* Ancho del logo: de grande y centrado a chico y pegado a la izquierda.
       Se anima el ANCHO (no un transform) para que el alto del header se achique
       de verdad: el alto de la imagen sigue al ancho por su proporción. */
    --logo-w-expandido: 500px;
    --logo-w-compacto: 190px;
    /* El min() va POR FUERA del calc: si queda anidado dentro de una resta con
       porcentajes, Chrome lo resuelve como 0. */
    --logo-w: min(100%, calc(var(--logo-w-expandido) - var(--scroll-progress) * (var(--logo-w-expandido) - var(--logo-w-compacto))));
    --bar-gap: 18px;
    /* Cuánto sube el buscador para ponerse al lado del logo (margen negativo:
       también recorta el alto del header, cosa que un translateY no hace). */
    --search-lift: -58px;
    padding:
        calc(var(--hero-pad-top) - var(--scroll-progress) * (var(--hero-pad-top) - var(--hero-pad-compacto)))
        1.5rem
        calc(var(--hero-pad-bottom) - var(--scroll-progress) * (var(--hero-pad-bottom) - var(--hero-pad-compacto)));
    text-align: center;
    /* El fondo se vuelve TRANSLÚCIDO al achicarse: si quedara opaco, el
       backdrop-filter no tendría nada para desenfocar y no se vería el efecto. */
    background:
        radial-gradient(circle at 50% -35%, color-mix(in srgb, var(--purple) calc(24% * (1 - var(--scroll-progress))), transparent) 0, transparent 58%),
        linear-gradient(180deg,
            color-mix(in srgb, var(--surface) calc((1 - var(--scroll-progress)) * 100%), transparent),
            color-mix(in srgb, var(--bg) calc((1 - var(--scroll-progress)) * 100%), transparent)),
        color-mix(in srgb, var(--surface) calc(var(--scroll-progress) * 55%), transparent);
    /* Blur + saturate emula el "vidrio esmerilado" de iOS en vez de un blur plano.
       Usa --blur-progress (escalonado) para no recalcular el filtro en cada cuadro. */
    backdrop-filter: blur(calc(var(--blur-progress) * var(--blur-max))) saturate(calc(1 + var(--blur-progress) * .8));
    -webkit-backdrop-filter: blur(calc(var(--blur-progress) * var(--blur-max))) saturate(calc(1 + var(--blur-progress) * .8));
    will-change: backdrop-filter;
    border-bottom: 1px solid color-mix(in srgb, var(--line) calc(var(--scroll-progress) * 100%), transparent);
}
/* Al achicarse, el contenido se ensancha para que el logo llegue al borde. */
.hero-content { width: min(100%, calc(850px + var(--scroll-progress) * 700px)); margin: auto; }
.brand-theme-toggle {
    position: relative; display: block; border: 0; background: transparent; outline-offset: 7px;
    width: var(--logo-w);
    /* De centrado (progreso 0) a pegado a la izquierda (progreso 1). El margen
       de abajo se va a 0 para que el header no conserve alto de más. */
    margin: 0 auto calc(1rem * (1 - var(--scroll-progress))) calc((100% - var(--logo-w)) * (1 - var(--scroll-progress)) / 2);
    /* Se convierte en una píldora gris a medida que se achica. */
    padding: calc(var(--scroll-progress) * .5rem) calc(var(--scroll-progress) * 1rem);
    border-radius: calc(12px + var(--scroll-progress) * 90px);
    background-color: color-mix(in srgb, var(--surface-soft) calc(var(--scroll-progress) * 100%), transparent);
    box-shadow: 0 calc(var(--scroll-progress) * 6px) calc(var(--scroll-progress) * 18px) rgba(0, 0, 0, calc(var(--scroll-progress) * .16));
}
.brand-theme-toggle:focus-visible { outline: 2px solid var(--accent); }
/* El width/height del HTML reserva la proporción antes de que cargue la imagen
   (evita que la página salte); acá se lo deja fluido dentro del botón. */
.brand-logo { display: block; width: 100%; height: auto; border-radius: 8px; }
.theme-hint { margin: .35rem 0 1.6rem; color: var(--muted); font-family: var(--font-detail); font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; }
h1, h2, .card-title { font-family: var(--font-title); }

/* Contenido secundario del header (texto de bienvenida y botones): se desvanece
   y colapsa a medida que se hace scroll, dejando solo el logo y el buscador fijos. */
.hero-secondary {
    opacity: calc(1 - var(--scroll-progress) * 1.6);
    max-height: calc((1 - var(--scroll-progress)) * 210px);
    overflow: hidden;
}
.hero--compacto .hero-secondary { pointer-events: none; visibility: hidden; }

/* 4. BUSCADOR Y BOTONES DEL ENCABEZADO. */
.search-container {
    /* Se angosta y sube (con margen negativo, que sí recorta el alto del header)
       hasta quedar a la derecha del logo, en la misma fila. La reducción se
       calcula en px puros: multiplicar un grupo que contiene min() da mal. */
    width: calc(100% - var(--scroll-progress) * (var(--logo-w-compacto) + var(--bar-gap)));
    margin: calc(var(--scroll-progress) * var(--search-lift)) 0 0 auto;
    /* Fila: el buscador se estira y el botón de filtros (solo en celular) va al lado. */
    display: flex; align-items: center; gap: .5rem;
}
.search-input {
    flex: 1; min-width: 0;
    width: 100%; padding: 1rem 1.2rem; color: var(--text); background: var(--surface);
    border: 1px solid var(--line-strong);
    /* Se redondea hasta quedar en forma de píldora al achicarse. */
    border-radius: calc(12px + var(--scroll-progress) * 987px);
    box-shadow: 0 calc(var(--scroll-progress) * 6px) calc(var(--scroll-progress) * 18px) rgba(0, 0, 0, calc(var(--scroll-progress) * .16));
}
/* El halo es decorativo y acompaña al click; el anillo de foco por teclado lo
   sigue poniendo :focus-visible (antes un outline:none lo borraba). */
.search-input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue) 20%, transparent); }
/* El margen también se colapsa: si no, sigue sumando alto al header achicado. */
.hero-actions { display: flex; justify-content: center; gap: .65rem; margin-top: calc(1rem * (1 - var(--scroll-progress))); }
.news-button, .mobile-filter-button {
    min-height: 42px; border: 1px solid var(--line); border-radius: 8px; padding: .62rem .85rem;
    color: var(--text); background: var(--surface-soft); font-family: var(--font-detail); font-size: .96rem; letter-spacing: .035em;
}
.news-button:hover, .mobile-filter-button:hover { border-color: var(--accent); color: var(--accent-ink); }
/* Solo aparece en celular (ver breakpoints). No se encoge: es el único acceso
   a los filtros y tiene que sobrevivir a que el buscador se angoste. */
.mobile-filter-button { display: none; flex-shrink: 0; align-items: center; gap: .35rem; white-space: nowrap; }
.mobile-filter-texto { display: inline; }

/* ================================================================
   5. ESTRUCTURA DEL CATÁLOGO
   En computadora muestra filtros a la izquierda y resultados a la derecha.
   ================================================================ */
.catalog-layout {
    display: grid; grid-template-columns: 254px minmax(0, 1fr); gap: 2.25rem;
    width: min(100% - 3rem, var(--container)); margin: 0 auto; padding: 2.5rem 0 5rem;
}
/* Cuando el sidebar de filtros de carreras está oculto (ej. en la pestaña de
   Centros deportivos), los resultados ocupan todo el ancho disponible. */
.catalog-layout:has(#filtersSidebar[hidden]) { grid-template-columns: 1fr; }
.results-area { min-width: 0; }

/* ================================================================
   6. PANEL DE FILTROS
   Estilos de los filtros laterales y de sus opciones.
   ================================================================ */
.filters-sidebar { align-self: start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
.filters-heading { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1rem .8rem; border-bottom: 1px solid var(--line); }
.filters-heading h2 { margin: 0; font-size: 1rem; }
.close-filters-button { display: none; padding: 0; color: var(--muted); background: none; border: 0; font-size: 1.5rem; line-height: 1; }
.filter-group { padding: 1rem; border-bottom: 1px solid var(--line); }
.filter-group h3 { margin: 0 0 .55rem; color: var(--text); font-family: var(--font-detail); font-size: 1rem; font-weight: 400; letter-spacing: .045em; }
.filter-options { display: flex; flex-direction: column; align-items: flex-start; gap: .18rem; }
.filter-options-inline { gap: .12rem; }
.filter-option {
    width: 100%; min-height: 30px; padding: .24rem 0; border: 0; color: var(--muted); background: transparent;
    text-align: left; font-size: .86rem; transition: color .16s ease;
}
.filter-option:hover { color: var(--accent-ink); }
.filter-option.active { color: var(--text); font-weight: 700; }
.filter-option.active::before { content: '•'; display: inline-block; width: .8rem; color: var(--accent-ink); }
.filter-option:not(.active)::before { content: ''; display: inline-block; width: .8rem; }
.filter-options-compact { max-height: 186px; overflow-y: auto; scrollbar-width: thin; }
.duration-range { display: grid; grid-template-columns: 1fr auto 1fr 30px; align-items: center; gap: .35rem; margin-top: .8rem; color: var(--muted); }
.duration-range input { min-width: 0; width: 100%; min-height: 34px; padding: .42rem .35rem; border: 1px solid var(--line-strong); border-radius: 6px; color: var(--text); background: var(--bg); font-size: .76rem; }
.duration-range input:focus { border-color: var(--accent); }
.duration-range button { height: 34px; border: 0; border-radius: 6px; color: var(--on-accent); background: var(--blue); font-weight: 800; }
.clear-filters-button { width: calc(100% - 2rem); min-height: 38px; margin: 1rem; padding: .55rem; border: 1px solid var(--line); border-radius: 7px; color: var(--muted); background: transparent; font-size: .8rem; }
.clear-filters-button:hover { border-color: var(--accent); color: var(--accent-ink); }

/* 7. BARRA SOBRE LOS RESULTADOS: cantidad encontrada y selector de orden. */
.results-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
.results-count { margin: 0; color: var(--muted); font-size: .92rem; font-weight: 600; }
/* El ícono recuerda en qué sección está parado el usuario (la barra solo se ve
   en Educación Formal; las plataformas tienen su propio encabezado). */
.results-count::before { content: '🎓 '; }
.sort-control { display: flex; align-items: center; gap: .5rem; color: var(--muted); font-size: .82rem; white-space: nowrap; }
.sort-control select { min-height: 38px; padding: .5rem .6rem; border: 1px solid var(--line-strong); border-radius: 7px; color: var(--text); background: var(--surface); }

/* ================================================================
   8. TARJETAS DE CARRERAS Y CURSOS
   Cambiá aquí el tamaño, color, bordes y distribución de cada tarjeta.
   ================================================================ */
.results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 1rem; }
/* Borde izquierdo azul: marca que la tarjeta es de Educación Formal, en paralelo
   al borde naranja de las tarjetas de plataformas. */
.card { display: flex; flex-direction: column; min-height: 260px; padding: 1.15rem; border: 1px solid var(--line); border-left: 4px solid var(--blue); border-radius: var(--radius); background: var(--surface); transition: transform .18s ease, border-color .18s ease; }
.card:hover { transform: translateY(-3px); border-color: var(--blue); }
.card-badges { display: flex; flex-wrap: wrap; gap: .35rem; }
.badge { padding: .23rem .5rem; border-radius: 999px; color: var(--muted); background: color-mix(in srgb, var(--muted) 12%, transparent); font-family: var(--font-detail); font-size: .76rem; font-weight: 400; letter-spacing: .045em; text-transform: uppercase; }
/* Mismo aspecto de siempre (tinte del color + texto del color), pero el texto usa
   la variante -ink: el matiz puro sobre su propio tinte no llegaba a 4.5:1. */
.badge-area { color: var(--orange-ink); background: color-mix(in srgb, var(--orange) 16%, transparent); }
.badge-publica { color: var(--blue-ink); background: color-mix(in srgb, var(--blue) 16%, transparent); }
.badge-privada { color: var(--purple-ink); background: color-mix(in srgb, var(--purple) 16%, transparent); }
.badge-modalidad { color: var(--green-ink); background: color-mix(in srgb, var(--green) 16%, transparent); }
.badge-fuente { color: var(--purple-ink); background: color-mix(in srgb, var(--purple) 16%, transparent); }
.badge-match { color: var(--purple-ink); background: color-mix(in srgb, var(--purple) 16%, transparent); }
.card-title { margin: .85rem 0 .75rem; font-size: 1.02rem; line-height: 1.35; overflow-wrap: anywhere; }
.card-info { color: var(--muted); font-size: .82rem; display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }
.card-info p { margin: 0; display: inline-flex; align-items: center; gap: .3rem; padding: .15rem .55rem; border-radius: 6px; background: color-mix(in srgb, var(--muted) 9%, transparent); }
.card-link { display: block; margin-top: auto; padding-top: 1rem; color: var(--accent-ink); font-size: .84rem; font-weight: 700; text-decoration: none; }
.card-link:hover { color: var(--purple-ink); }
.card-link-muted { color: var(--muted); }
.empty-state {
    grid-column: 1 / -1; padding: 3rem 1rem; color: var(--muted);
    text-align: center; font-size: .92rem;
}
/* Ilustración de los estados vacíos. Va por mask-image y no background-image:
   dentro de un data-URI, currentColor no tiene de quién heredar y se resolvía a
   negro, así que en tema oscuro el ícono era invisible. Con máscara, el color lo
   aporta background-color y sí acompaña al tema. */
.empty-state::before {
    content: ""; display: block; width: 72px; height: 72px; margin: 0 auto 1.1rem;
    background-color: currentColor;
    mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2224%22%20cy%3D%2224%22%20r%3D%229%22%2F%3E%3Cline%20x1%3D%2236%22%20y1%3D%2236%22%20x2%3D%2254%22%20y2%3D%2254%22%2F%3E%3Cline%20x1%3D%222%22%20y1%3D%2238%22%20x2%3D%2214%22%20y2%3D%2238%22%2F%3E%3Cline%20x1%3D%222%22%20y1%3D%2244%22%20x2%3D%2220%22%20y2%3D%2244%22%2F%3E%3Cline%20x1%3D%222%22%20y1%3D%2250%22%20x2%3D%2212%22%20y2%3D%2250%22%2F%3E%3C%2Fsvg%3E");
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2224%22%20cy%3D%2224%22%20r%3D%229%22%2F%3E%3Cline%20x1%3D%2236%22%20y1%3D%2236%22%20x2%3D%2254%22%20y2%3D%2254%22%2F%3E%3Cline%20x1%3D%222%22%20y1%3D%2238%22%20x2%3D%2214%22%20y2%3D%2238%22%2F%3E%3Cline%20x1%3D%222%22%20y1%3D%2244%22%20x2%3D%2220%22%20y2%3D%2244%22%2F%3E%3Cline%20x1%3D%222%22%20y1%3D%2250%22%20x2%3D%2212%22%20y2%3D%2250%22%2F%3E%3C%2Fsvg%3E");
    mask-size: contain; mask-repeat: no-repeat; mask-position: center;
    -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center;
    opacity: .85;
}
/* Empty de favoritos: ícono de estrella vacía a juego con el mensaje. */
.empty-favoritos::before {
    width: 64px; height: 64px;
    mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M32%208l7.9%2016.4L56%2024.4l-12%2011.6%202.8%2016.3L32%2044.6l-14.8%207.7%202.8-16.3L8%2024.4z%22%2F%3E%3C%2Fsvg%3E");
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M32%208l7.9%2016.4L56%2024.4l-12%2011.6%202.8%2016.3L32%2044.6l-14.8%207.7%202.8-16.3L8%2024.4z%22%2F%3E%3C%2Fsvg%3E");
}
.empty-favoritos strong { color: var(--orange-ink); }
.results-suggest {
    grid-column: 1 / -1; margin: 0 0 .25rem; padding: 1rem 1.1rem;
    border: 1px solid var(--line); border-left: 4px solid var(--orange);
    border-radius: var(--radius); background: var(--surface);
    color: var(--text); font-size: .92rem;
}
.results-suggest strong { color: var(--orange-ink); }

.cargar-mas {
    display: block; margin: 1.5rem auto 0; min-height: 44px; padding: .7rem 1.6rem;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
    color: var(--accent-ink); font-family: var(--font-text); font-size: .9rem; font-weight: 700;
    cursor: pointer; transition: border-color .15s ease, color .15s ease, transform .15s ease;
}
.cargar-mas:hover { border-color: var(--accent); transform: translateY(-1px); }
.cargar-mas:active { transform: translateY(0); }

/* ================================================================
   8b. SECCIONES PRINCIPALES: EDUCACIÓN FORMAL vs PLATAFORMAS ONLINE
   Es la primera decisión del usuario. Cada sección tiene su color e ícono,
   y --seccion tiñe todo lo que depende de dónde está parado.
   ================================================================ */
/* --seccion es el relleno/borde; --seccion-ink es su tinta legible. Van siempre
   en pareja, igual que los badges. */
body[data-seccion="formal"]                    { --seccion: var(--blue);   --seccion-ink: var(--blue-ink); }
body[data-seccion="plataformas"]               { --seccion: var(--orange); --seccion-ink: var(--orange-ink); }
body[data-seccion="formaciones-alternativas"]  { --seccion: var(--purple); --seccion-ink: var(--purple-ink); }
body[data-seccion="oficios-tecnicos"]          { --seccion: var(--green);  --seccion-ink: var(--green-ink); }

.section-tabs {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: .85rem;
    width: min(100% - 3rem, var(--container)); margin: 1.75rem auto 0;
}
.section-tab {
    display: flex; align-items: center; gap: .85rem;
    padding: 1.05rem 1.2rem; text-align: left;
    border: 2px solid var(--line); border-radius: var(--radius);
    background: var(--surface); color: var(--muted);
    transition: border-color .18s ease, color .18s ease, background-color .18s ease, transform .18s ease;
}
.section-tab:hover { transform: translateY(-2px); }
.section-tab-icon { font-size: 1.7rem; line-height: 1; }
.section-tab-texto { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
.section-tab-texto strong { font-family: var(--font-title); font-size: 1.12rem; color: var(--text); }
.section-tab-texto small { font-size: .78rem; overflow-wrap: anywhere; }

/* La pestaña activa se pinta con el color de SU sección, no con el global. */
.section-tab-formal.is-active       { --tono: var(--blue);   --tono-ink: var(--blue-ink); }
.section-tab-plataformas.is-active  { --tono: var(--orange); --tono-ink: var(--orange-ink); }
.section-tab-formaciones.is-active  { --tono: var(--purple); --tono-ink: var(--purple-ink); }
.section-tab-oficios.is-active      { --tono: var(--green);  --tono-ink: var(--green-ink); }
.section-tab.is-active {
    border-color: var(--tono);
    background: color-mix(in srgb, var(--tono) 12%, var(--surface));
}
.section-tab.is-active .section-tab-texto strong { color: var(--tono-ink); }
.section-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ================================================================
   8c. TARJETAS DE PLATAFORMAS ONLINE
   Una tarjeta por plataforma (no por curso): quién es, qué enseña y
   un botón que lleva a su sitio oficial a ver el catálogo completo.
   ================================================================ */
.platforms-section h2 { margin: 0 0 .4rem; font-size: 1.35rem; color: var(--orange-ink); }
.platforms-intro { margin: 0 0 1.4rem; color: var(--muted); font-size: .9rem; }
.platforms-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1rem; }
.platform-card {
    display: flex; flex-direction: column; padding: 1.15rem;
    border: 1px solid var(--line); border-left: 4px solid var(--orange);
    border-radius: var(--radius); background: var(--surface);
    transition: transform .18s ease, border-color .18s ease;
}
.platform-card:hover { transform: translateY(-3px); border-color: var(--orange); }
.platform-head { display: flex; align-items: center; gap: .7rem; margin-bottom: .7rem; }
/* Espacio del logo: si se agrega la imagen, ocupa este mismo lugar (ver app.js). */
.platform-logo {
    flex: 0 0 auto; width: 44px; height: 44px; border-radius: 10px;
    object-fit: contain; background: var(--surface-soft);
}
.platform-logo-vacio {
    display: grid; place-items: center;
    color: var(--orange-ink); font-family: var(--font-title); font-size: 1.35rem;
    border: 1px dashed color-mix(in srgb, var(--orange) 45%, transparent);
}
.platform-name { margin: 0; font-family: var(--font-title); font-size: 1.08rem; overflow-wrap: anywhere; }
.platform-summary { margin: 0 0 .85rem; color: var(--muted); font-size: .86rem; line-height: 1.45; }
.platform-meta { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: 1rem; }
.platform-link {
    margin-top: auto; padding: .6rem .8rem; border-radius: 8px; text-align: center;
    color: var(--on-accent); background: var(--orange);
    font-size: .85rem; font-weight: 700; text-decoration: none;
}
.platform-link:hover { background: color-mix(in srgb, var(--orange) 82%, var(--text)); }
.platform-link-muted { color: var(--muted); background: var(--surface-soft); }

/* ================================================================
   8d. CATÁLOGOS APARTE: FORMACIONES ALTERNATIVAS Y OFICIOS TÉCNICOS
   Vista propia por sección, sin los filtros de carreras. El color sale
   de --seccion, que cambia según la pestaña activa.
   ================================================================ */
.catalog-aparte h2 { margin: 0 0 .4rem; font-size: 1.35rem; color: var(--seccion-ink); }
.catalog-aparte-intro { margin: 0 0 1.4rem; color: var(--muted); font-size: .9rem; }
.cursos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(265px, 1fr)); gap: 1rem; }
.curso-card {
    display: flex; flex-direction: column; padding: 1.15rem;
    border: 1px solid var(--line); border-left: 4px solid var(--seccion);
    border-radius: var(--radius); background: var(--surface);
    transition: transform .18s ease, border-color .18s ease;
}
.curso-card:hover { transform: translateY(-3px); border-color: var(--seccion); }
.curso-title { margin: .85rem 0 .75rem; font-family: var(--font-title); font-size: 1.02rem; line-height: 1.35; overflow-wrap: anywhere; }
.badge-seccion { color: var(--seccion-ink); background: color-mix(in srgb, var(--seccion) 16%, transparent); }

/* Plataformas que aparecen al buscar dentro de Educación Formal. */
.platform-matches {
    margin-top: 2.25rem; padding-top: 1.35rem;
    border-top: 2px dashed color-mix(in srgb, var(--orange) 45%, transparent);
}
.platform-matches h3 { margin: 0 0 1rem; font-size: 1.05rem; color: var(--orange-ink); }

/* 9. SECCIÓN DE NOTICIAS Y SUS TARJETAS. */
.news-section h2 { margin: 0 0 1rem; font-size: 1.35rem; }
.news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
.news-card { display: flex; flex-direction: column; min-height: 190px; padding: 1.15rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
.news-card p { margin: 0; color: var(--muted); font-size: .75rem; }
.news-card h3 { margin: .75rem 0; font-size: 1rem; }
.news-card a { margin-top: auto; color: var(--accent-ink); font-size: .85rem; font-weight: 700; text-decoration: none; }

/* 9b. CENTROS DEPORTIVOS (vista separada, reutiliza estilos de noticias). */
.sports-filter { margin-bottom: 1.25rem; }
.sports-card p + p { margin-top: .35rem; }
.sports-card h3 { margin: .35rem 0 .5rem; }
.sports-card .card-badges { margin: .5rem 0; }
.sports-card .card-badges + p { margin-top: .35rem; }

/* ================================================================
   10. CHAT FLOTANTE Y FONDO AL ABRIR FILTROS EN CELULAR.
   ================================================================ */
.filters-overlay { display: none; }
/* z-index alto: el chat tiene que quedar por delante del header fijo (40) y del
   panel de filtros (45) para poder abrirse y verse en cualquier momento. */
.chat-widget { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 60; }
.btn-chat-toggle { min-height: 44px; border: 0; border-radius: 99px; padding: .78rem 1rem; color: var(--on-purple); background: var(--purple-fill); box-shadow: 0 10px 28px var(--shadow); font-weight: 700; }
.ventana-chat { position: absolute; right: 0; bottom: 3.75rem; width: min(440px, calc(100vw - 2rem)); min-height: 360px; max-height: min(680px, calc(100vh - 5.5rem)); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--surface); box-shadow: 0 16px 40px var(--shadow); display: flex; flex-direction: column; }
.oculto { display: none; }
.chat-header { display: flex; align-items: center; justify-content: space-between; padding: .8rem .95rem; border-bottom: 1px solid var(--line); font-size: .9rem; font-weight: 700; }
.chat-header button { display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; margin: -.35rem -.5rem -.35rem 0;
    border: 0; border-radius: var(--radius-sm); color: var(--muted); background: none; font-size: 1rem; }
.chat-cuerpo { flex: 1; min-height: 0; padding: .9rem; overflow-y: auto; color: var(--muted); font-size: .85rem; display: flex; flex-direction: column; gap: .55rem; }

/* Barra de progreso fija del test vocacional (arriba, fuera del scroll) */
.chat-progreso-fijo { padding: .75rem .9rem .15rem; border-bottom: 1px solid var(--line); }

/* Caja de escritura libre al pie del chat */
.chat-input { display: flex; align-items: center; gap: .45rem; padding: .6rem .7rem; border-top: 1px solid var(--line); background: var(--surface); }
#chat-input-texto { flex: 1; min-width: 0; min-height: 44px; padding: .45rem .7rem; border: 1px solid var(--line-strong); border-radius: 99px; color: var(--text); background: var(--surface-soft); font-size: .82rem; }
#chat-input-texto::placeholder { color: var(--muted); }
#chat-input-texto:focus { border-color: var(--accent); }
#chat-input-enviar { flex: none; width: 38px; height: 38px; border: 0; border-radius: 50%; color: var(--on-accent); background: var(--accent); font-size: .95rem; cursor: pointer; transition: filter .15s ease; }
#chat-input-enviar:hover { filter: brightness(1.1); }
#chat-input-enviar:disabled { opacity: .5; cursor: default; }

/* Burbuja del usuario: a la derecha y con el acento de la sección */
.mensaje-usuario { align-self: flex-end; max-width: 88%; padding: .7rem .85rem; border-radius: 12px 12px 3px 12px; background: var(--accent); color: var(--on-accent); line-height: 1.4; }
.mensaje-usuario p { margin: 0; }

/* Sugerencias rápidas que el bot propone como botones */
.chat-sugerencias { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .55rem; }
.btn-chat-sugerencia { min-height: 36px; padding: .4rem .65rem; border: 1px dashed var(--line); border-radius: 99px; color: var(--muted); background: transparent; font-size: .76rem; transition: border-color .15s ease, color .15s ease; }
.btn-chat-sugerencia:hover, .btn-chat-sugerencia:focus-visible { border-color: var(--accent); color: var(--accent-ink); }

/* Barra de progreso del test vocacional */
.chat-progreso { height: 6px; border-radius: 999px; background: var(--line); overflow: hidden; margin-bottom: .55rem; }
.chat-progreso span { display: block; height: 100%; background: var(--accent); transition: width .3s ease; }
.chat-progreso-texto { margin: 0 0 .75rem; color: var(--muted); font-family: var(--font-detail); font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; }

/* Burbujas de mensaje del bot */
.mensaje-bot { padding: .7rem .85rem; border-radius: 12px 12px 12px 3px; background: var(--surface-soft); color: var(--text); }
.mensaje-bot p { margin: 0; line-height: 1.45; }
.mensaje-bot ul { margin: .4rem 0 0; padding-left: 1.15rem; display: flex; flex-direction: column; gap: .3rem; }
.mensaje-bot li { line-height: 1.4; }
.mensaje-bot strong { color: var(--accent-ink); }
.mensaje-bot.final { display: flex; flex-direction: column; gap: .55rem; }
.mensaje-bot-nota { margin: 0; color: var(--muted); font-size: .78rem; }

/* Indicador de "escribiendo…" mientras se procesa la respuesta */
.mensaje-escribiendo { display: flex; align-items: center; gap: 4px; width: fit-content; padding: .85rem 1rem; }
.mensaje-escribiendo span { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: chat-typing 1s infinite ease-in-out; }
.mensaje-escribiendo span:nth-child(2) { animation-delay: .15s; }
.mensaje-escribiendo span:nth-child(3) { animation-delay: .3s; }
@keyframes chat-typing { 0%, 60%, 100% { transform: translateY(0); opacity: .4; } 30% { transform: translateY(-4px); opacity: 1; } }

/* Opciones de respuesta y navegación del test */
.opciones-usuario { display: flex; flex-direction: column; gap: .5rem; margin-top: .75rem; }
.btn-chat-opcion { min-height: 44px; padding: .6rem .75rem; border: 1px solid var(--line); border-radius: 10px; color: var(--text); background: var(--surface); font-size: .83rem; line-height: 1.35; text-align: left; transition: border-color .15s ease, background .15s ease; }
.btn-chat-opcion:hover, .btn-chat-opcion:focus-visible { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
.btn-chat-atras { display: block; width: 100%; margin-top: .75rem; padding: .4rem; border: 0; color: var(--muted); background: none; font-size: .76rem; text-decoration: underline; }
.btn-chat-atras:hover { color: var(--text); }
.btn-chat-resultado { width: 100%; min-height: 44px; margin-top: .1rem; padding: .65rem; border: 0; border-radius: 8px; color: var(--on-accent); background: var(--accent); font-weight: 700; }
.btn-chat-reset { width: 100%; min-height: 40px; padding: .55rem; border: 1px solid var(--line); border-radius: 8px; color: var(--text); background: transparent; font-size: .82rem; }

/* ================================================================
   11. DISEÑO PARA TABLETS Y CELULARES (hasta 820px).
   Convierte el filtro lateral en un panel deslizante y deja una tarjeta
   por fila para facilitar la lectura y los toques.
   ================================================================ */
@media (max-width: 820px) {
    body { padding-top: var(--hero-alto, 410px); }
    /* Desenfoque más chico: en celulares es la operación más cara del scroll. */
    .hero { --hero-pad-top: 3.25rem; --hero-pad-bottom: 2.25rem; --logo-w-compacto: 160px; --search-lift: -54px; --bar-gap: 14px; --blur-max: 20px; }
    .mobile-filter-button { display: inline-flex; justify-content: center; min-width: 44px; min-height: 44px; }
    /* Compactado queda poco ancho al lado del logo: se deja solo el ícono. */
    .hero--compacto .mobile-filter-texto { display: none; }
    .catalog-layout { display: block; width: min(100% - 2rem, 680px); padding: 1.5rem 0 calc(5rem + env(safe-area-inset-bottom)); }
    /* z-index por encima del header fijo (.hero, z-index 40): si se scrollea y se abre
       el panel de filtros, tiene que taparlo, no quedar debajo. */
    .filters-sidebar { position: fixed; z-index: 45; top: 0; bottom: 0; left: 0; width: min(320px, 90vw); height: 100dvh; max-height: 100dvh; padding-bottom: calc(1rem + env(safe-area-inset-bottom)); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; touch-action: pan-y; border-radius: 0 14px 14px 0; transform: translateX(-105%); transition: transform .22s ease; scrollbar-color: var(--accent) var(--surface); scrollbar-width: thin; }
    .filters-heading { position: sticky; z-index: 2; top: 0; background: color-mix(in srgb, var(--surface) 94%, transparent); backdrop-filter: blur(10px); }
    .filters-open .filters-sidebar { transform: translateX(0); }
    .filters-overlay { position: fixed; z-index: 42; inset: 0; background: rgba(2, 6, 23, .72); opacity: 0; transition: opacity .22s ease; pointer-events: none; }
    .filters-open .filters-overlay { display: block; opacity: 1; pointer-events: auto; }
    .filters-open { overflow: hidden; }
    .close-filters-button { display: block; min-width: 44px; min-height: 44px; }
    .results-grid, .news-grid, .platforms-grid, .cursos-grid { grid-template-columns: 1fr; }
    .card { min-height: 0; }
    .section-tabs { width: min(100% - 2rem, 680px); margin-top: 1.25rem; }
    /* El chat abre como una hoja que cubre casi toda la pantalla. */
    .ventana-chat { position: fixed; left: .6rem; right: .6rem; top: .6rem; bottom: 5rem; width: auto; min-height: 0; max-height: none; border-radius: 16px; }
    .btn-chat-toggle { max-width: calc(100vw - 1.5rem); }
}

/* ================================================================
   12. DISEÑO PARA CELULARES PEQUEÑOS (hasta 480px).
   Ajusta espacios, botones y controles para pantallas angostas.
   ================================================================ */
@media (max-width: 480px) {
    body { padding-top: var(--hero-alto, 390px); }
    .hero { --hero-pad-top: 2.5rem; --hero-pad-bottom: 1.75rem; --logo-w-compacto: 120px; --search-lift: -45px; --bar-gap: 10px; --blur-max: 16px; }
    .search-input { min-height: 48px; padding: .8rem 1rem; }
    .hero-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    /* Solo los de .hero-actions se estiran en la grilla; el de filtros vive en la
       fila del buscador y tiene que conservar su ancho propio. */
    .news-button { width: 100%; padding-inline: .5rem; font-size: .84rem; }
    .mobile-filter-button { padding-inline: .6rem; font-size: .84rem; }
    .catalog-layout { width: min(100% - 1.25rem, 680px); padding-top: 1.1rem; }
    /* En celular van apiladas: son la decisión principal, conviene que se lean grandes. */
    .section-tabs { grid-template-columns: 1fr; gap: .6rem; width: min(100% - 1.25rem, 680px); }
    .section-tab { padding: .85rem 1rem; }
    .section-tab-icon { font-size: 1.45rem; }
    .results-toolbar { align-items: stretch; flex-direction: column; gap: .65rem; margin-bottom: 1rem; }
    .sort-control { width: 100%; justify-content: space-between; white-space: normal; }
    .sort-control select { width: min(66%, 220px); }
    .card, .news-card { padding: 1rem; }
    .card-title { font-size: 1rem; }
    .filter-group { padding: .9rem 1rem; }
    .chat-widget { right: .75rem; bottom: calc(.75rem + env(safe-area-inset-bottom)); }
    .btn-chat-toggle { padding: .7rem .8rem; font-size: .78rem; }
    /* Ojo: acá NO se puede redeclarar width/max-height. La hoja de ≤820px posiciona
       con left/right/top/bottom, y volver a fijar tamaño sin resetear esos cuatro
       dejaba el panel pegado arriba tapando el header. Hereda la hoja y listo. */
    .chat-header { padding: .6rem .75rem; font-size: .8rem; }
    .chat-cuerpo { padding: .6rem; font-size: .78rem; gap: .4rem; }
    .chat-input { padding: .45rem .55rem; }
    /* Solo tipografía y padding: el tamaño mínimo lo fija el bloque de
       (pointer: coarse) y acá se achicaba por debajo de los 44px. */
    #chat-input-texto { padding: .35rem .6rem; font-size: .78rem; }
    #chat-input-enviar { font-size: .85rem; }
    .chat-progreso-fijo { padding: .5rem .7rem .1rem; }
}

/* 13. CELULARES MUY ANGOSTOS (hasta 360px): evita que los botones se corten. */
@media (max-width: 360px) {
    .hero-actions { grid-template-columns: 1fr; }
    .sort-control { align-items: flex-start; flex-direction: column; }
    .sort-control select { width: 100%; }
}

/* ================================================================
   14. FAVORITOS Y COMPARADOR
   Botones de tarjeta, toggle de favoritos en la toolbar y el modal
   de comparación lado a lado.
   ================================================================ */
.toolbar-actions { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }

.favoritos-toggle {
    min-height: 38px; padding: .5rem .8rem; border: 1px solid var(--line);
    border-radius: 7px; color: var(--text); background: var(--surface);
    font-family: var(--font-text); font-size: .82rem; font-weight: 700; cursor: pointer;
    transition: border-color .15s ease, color .15s ease;
}
.favoritos-toggle:hover { border-color: var(--orange); color: var(--orange-ink); }
.favoritos-toggle.active { color: var(--on-accent); background: var(--orange); border-color: var(--orange); }

.card-actions { display: flex; gap: .5rem; margin-top: 1rem; }
.btn-favorito, .btn-comparar {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: .35rem;
    min-height: 38px; padding: .45rem .6rem; border: 1px solid var(--line);
    border-radius: 8px; color: var(--muted); background: var(--surface-soft);
    font-family: var(--font-text); font-size: .78rem; font-weight: 700; cursor: pointer;
    transition: border-color .15s ease, color .15s ease, background .15s ease;
}
.btn-favorito:hover, .btn-comparar:hover { border-color: var(--accent); color: var(--accent-ink); }
.btn-favorito.is-active { color: var(--on-accent); background: var(--orange); border-color: var(--orange); }
.btn-comparar.is-active { color: var(--on-accent); background: var(--blue); border-color: var(--blue); }

/* Barra flotante del comparador, fija abajo centrada. */
.comparar-bar {
    position: fixed; left: 50%; bottom: calc(4rem + env(safe-area-inset-bottom));
    transform: translateX(-50%); z-index: 65;
    display: flex; align-items: center; gap: .75rem;
    padding: .6rem .8rem; border: 1px solid var(--line); border-radius: 999px;
    background: var(--surface); box-shadow: 0 10px 30px var(--shadow);
    font-family: var(--font-text); font-size: .85rem;
}
.comparar-bar-texto { color: var(--text); }
.comparar-bar-btn {
    min-height: 34px; padding: .35rem .9rem; border: none; border-radius: 999px;
    color: var(--on-accent); background: var(--blue); font-weight: 700; cursor: pointer;
}
.comparar-bar-btn:hover { background: color-mix(in srgb, var(--blue) 82%, #000); }
.comparar-bar-limpiar {
    min-height: 34px; padding: .35rem .7rem; border: 1px solid var(--line);
    border-radius: 999px; color: var(--muted); background: transparent; cursor: pointer;
}

/* Modal de comparación. */
.comparar-modal {
    position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center;
    padding: 1rem; background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(3px);
}
.comparar-modal-contenido {
    width: min(100%, 860px); max-height: 86vh; overflow: auto;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); box-shadow: 0 20px 60px var(--shadow);
}
.comparar-modal-cabecera {
    position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--surface);
}
.comparar-modal-cabecera h2 { margin: 0; font-family: var(--font-detail); font-size: 1.4rem; letter-spacing: .04em; }
.comparar-modal-cerrar {
    width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 8px;
    color: var(--text); background: var(--surface-soft); font-size: 1rem; cursor: pointer;
}
.comparar-modal-cuerpo { padding: 1rem 1.25rem 1.5rem; }
/* Contenedor de scroll de la tabla: sin esto, comparar muchas carreras desbordaba
   el modal a lo ancho y se llevaba puesto el botón de cerrar. */
.comparar-responsive { max-width: 100%; overflow-x: auto; }
.tabla-comparar { width: 100%; border-collapse: collapse; font-size: .85rem; }
.tabla-comparar th, .tabla-comparar td { padding: .65rem .75rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
.tabla-comparar thead th { font-family: var(--font-detail); font-size: 1rem; letter-spacing: .03em; color: var(--text); }
.tabla-comparar tbody th[scope="row"] { color: var(--muted); font-weight: 600; white-space: nowrap; }

/* Vista apilada (móvil): una tarjeta por ítem, cada atributo como fila
   etiqueta/valor. La tabla de al lado queda oculta en pantallas angostas. */
.comparar-movil { display: none; }
.comparar-item {
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-soft);
    padding: .9rem 1rem; margin-bottom: .9rem;
}
.comparar-item-titulo { margin: 0 0 .6rem; font-size: 1.05rem; line-height: 1.3; }
.comparar-item-lista { margin: 0; }
.comparar-fila { display: flex; gap: .6rem; padding: .35rem 0; border-top: 1px solid var(--line); }
.comparar-fila:first-child { border-top: none; }
.comparar-fila dt { flex: 0 0 42%; color: var(--muted); font-weight: 600; font-size: .8rem; }
.comparar-fila dd { margin: 0; flex: 1; font-size: .82rem; }

/* 820px, no 600: es el mismo punto en que el layout pasa a una columna. Con 600
   quedaba una franja de 601-820px con la tabla ancha (y sus <th> nowrap) metida
   en un modal angosto. */
@media (max-width: 820px) {
    .comparar-bar { left: .75rem; right: .75rem; transform: none; flex-wrap: wrap; justify-content: center; }
    .tabla-comparar { display: none; }
    .comparar-movil { display: block; }
}


/* ================================================================
   15. PREFERENCIAS DEL SISTEMA
   Van al final a propósito: las media queries no suman especificidad, así que
   para ganarle a reglas como `.filter-option { min-height: 30px }` tienen que
   venir después en el archivo.
   ================================================================ */
/* Movimiento reducido. Lo más agresivo de la página es el header, que se
   reescala entero (logo, padding, radios y un blur de hasta 34px) en cada cuadro
   del scroll. Con esta preferencia activa se congela en su estado compacto:
   --scroll-progress queda fijo en 1 y no hay nada que animar. */
@media (prefers-reduced-motion: reduce) {
    :root { --scroll-progress: 1; --blur-progress: 0; }
    *, *::before, *::after {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001ms !important;
        scroll-behavior: auto !important;
    }
    /* Los "levantarse" del hover no aportan información, solo movimiento. */
    .card:hover, .platform-card:hover, .curso-card:hover,
    .section-tab:hover, .cargar-mas:hover { transform: none; }
}

/* Área táctil mínima de 44px donde se toca con el dedo. Se decide por tipo de
   puntero y no por ancho: un tablet grande también se toca, y en escritorio con
   mouse llevar todo a 44px estiraría de más la lista de filtros. */
@media (pointer: coarse) {
    .filter-option { min-height: 44px; }
    .duration-range button, .duration-range input,
    .comparar-bar-btn, .comparar-bar-limpiar, .comparar-modal-cerrar,
    .btn-favorito, .btn-comparar, .favoritos-toggle, .clear-filters-button,
    .btn-chat-sugerencia, .sort-control select, .news-button,
    .card-link, .news-card a, .platform-link,
    #chat-input-enviar, #chat-input-texto { min-height: 44px; }
    #chat-input-enviar { width: 44px; height: 44px; }
    .duration-range { grid-template-columns: 1fr auto 1fr 44px; }
}
